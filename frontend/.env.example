
# FastAPI Backend Gateway URL (Default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Polygon Amoy Block Explorer Base URL
NEXT_PUBLIC_POLYGONSCAN_URL=https://amoy.polygonscan.com

# Polygon Smart Contract Address (Optional, overrides default contract)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Razorpay Test Key ID (Public key for checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Default Currency Code (e.g. INR)
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

