# Application & Gateway Configuration
APP_NAME="Eleos Unified Backend Gateway"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eleos

# Direct SQLAlchemy connection strings (local or hosted e.g. Supabase pooler)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eleos
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eleos

# Supabase Integration (Optional direct REST / Auth API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# JWT Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_generate_using_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Razorpay Payment Gateway (Test Mode / Sandbox)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_CURRENCY=INR
RAZORPAY_TEST_MODE=true

# Blockchain (Polygon Amoy Testnet & Web3.py)
POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
CHAIN_ID=80002
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BACKEND_PRIVATE_KEY=your_hex_private_key_without_0x_prefix
POLYGONSCAN_BASE_URL=https://amoy.polygonscan.com
BLOCKCHAIN_TEST_MODE=false


# AI & Document Extraction (Google Gemini / Textract)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional AWS credentials for Textract:
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=ap-south-1

# Email Dispatcher & Google AMP for Email (Resend / SMTP)
RESEND_API_KEY=re_placeholder_api_key_here
RESEND_FROM_EMAIL=Eleos Peer Review <onboarding@resend.dev>

# Optional SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Redis (WebSocket Pub/Sub & Caching)
REDIS_URL=redis://localhost:6379/0

# Donor Review Threshold
DONOR_REVIEW_THRESHOLD_INR=500.0
